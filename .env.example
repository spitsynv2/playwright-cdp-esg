ESG_HOST=
ESG_USER=
ESG_PASSWORD=
# Zebrunner launcher can set ZEBRUNNER_HUB_URL instead of ESG_HOST, ESG_USER, and ESG_PASSWORD.

ESG_BROWSER_NAME=chrome
ESG_BROWSER_VERSION=latest
ESG_PLATFORM_NAME=linux
ESG_WORKERS=2

# Farm records video. Keep Playwright use.video off in playwright.config.ts.
ESG_ENABLE_VIDEO=true
ESG_ENABLE_LOG=true
ESG_ENABLE_VNC=true
ESG_ENABLE_DEBUG=false
ESG_CPU=2048
ESG_MEMORY=2048
ESG_IDLE_TIMEOUT=120
ESG_MAX_TIMEOUT=3600
ESG_SCREEN_RESOLUTION=1920x1080x24
ESG_VIDEO_SCREEN_SIZE=1920x1080
ESG_FRAME_RATE=12
ESG_TIME_ZONE=UTC

ESG_SESSION_CREATE_TIMEOUT_MS=600000
ESG_SESSION_CLOSE_TIMEOUT_MS=30000
ESG_WINDOW_MAXIMIZE_TIMEOUT_MS=30000
ESG_SESSION_FIXTURE_TIMEOUT_MS=660000
ESG_CDP_CONNECT_TIMEOUT_MS=60000
ESG_BROWSER_FIXTURE_TIMEOUT_MS=70000
ESG_TEST_TIMEOUT_MS=120000
ESG_STEP_PAUSE_MS=5000
ESG_RETRY_DEMO=false
ESG_STRESS_TEST=false
ESG_STRESS_TESTS=8
ESG_STRESS_DURATION_MS=60000
ESG_STRESS_WORKERS=8

REPORTING_ENABLED=true
REPORTING_PROJECT_KEY=DEF
REPORTING_SERVER_HOSTNAME=
REPORTING_SERVER_ACCESS_TOKEN=
REPORTING_LAUNCH_DISPLAY_NAME=Playwright Chrome on ESG
REPORTING_LAUNCH_BUILD=1.0.0
REPORTING_LAUNCH_ENVIRONMENT=grid
REPORTING_LOGS_FLUSH_INTERVAL_MS=1000
